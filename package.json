{
  "name": "games-camp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "generate:schemas": "tsx scripts/generateSchemas.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate:kits": "tsx scripts/validateAllKits.ts",
    "validate:recipes": "tsx scripts/validateAllRecipes.ts",
    "validate:kit-registry": "tsx scripts/validateKitRegistry.ts",
    "validate:recipe-compatibility": "tsx scripts/validateRecipeCompatibility.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^8.0.14",
    "zod-to-json-schema": "^3.23.5"
  }
}
