      "type": "number",
      "default": 0.14,
      "min": 0,
      "max": 1
    }
  },
  "invariants": ["mustNotOwnWinCondition"],
  "entry": "src/kits/cameras/isometricSoft/IsometricSoftCamera.ts"
}
