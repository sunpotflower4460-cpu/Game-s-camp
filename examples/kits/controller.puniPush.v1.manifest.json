    },
    "pushPower": {
      "type": "number",
      "default": 1.2,
      "min": 0.2,
      "max": 3,
      "description": "Relative push strength."
    }
  },
  "invariants": [
    "mustNotControlCamera",
    "mustNotCreateWinCondition",
    "mustUseRuntimeInputManager"
  ],
  "entry": "src/kits/controllers/puniPush/PuniPushController.ts",
  "testFixture": "src/kits/controllers/puniPush/PuniPushController.fixture.ts"
