{
  "id": "controller.puniPush.v1",
  "name": "Puni Push Controller",
  "category": "controller",
  "engine": "phaser",
  "version": "0.1.0",
  "description": "Placeholder manifest for a future soft pushing controller used by Puni Sumo.",
  "provides": ["playerMovement", "pushForce"],
  "requires": ["input.pointerOrKeyboard"],
  "compatibleWith": {
    "templates": ["template.miniAction.v1"],
    "inputs": ["mobile_drag", "keyboard_wasd"],
    "cameras": ["camera.isometricSoft.v1"]
