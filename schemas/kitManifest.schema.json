{
  "$ref": "#/definitions/KitManifest",
  "definitions": {
    "KitManifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:\\.[a-zA-Z]+)*\\.v[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "controller",
            "camera",
            "physics",
            "stage",
            "rule",
            "ui",
            "visual",
            "audio",
            "npc"
          ]
        },
        "engine": {
          "type": "string",
          "enum": [
            "phaser"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "compatibleWith": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        },
        "tunables": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "default": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "string"
                  },
                  "default": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "default": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            ]
          },
          "default": {}
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "testFixture": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "engine",
        "version",
        "description",
        "entry"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
